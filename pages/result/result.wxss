.result-page {
  box-sizing: border-box;
  min-height: 100vh;
  overflow-x: hidden;
}

.result-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  min-height: 88rpx;
  padding: 4rpx 4rpx 34rpx;
}

.page-title {
  font-size: 46rpx;
  font-weight: 700;
  letter-spacing: -2rpx;
  line-height: 1.2;
}

.finish-button {
  min-width: 112rpx;
  min-height: 88rpx;
  margin: 0 -18rpx 0 20rpx;
  padding: 0 18rpx;
  background: transparent;
  color: var(--blue);
  font-size: 27rpx;
  font-weight: 650;
  line-height: 88rpx;
}

.collector-hero {
  box-sizing: border-box;
  width: 100%;
  padding: 38rpx;
  border-radius: 36rpx;
  background: #1c1f23;
  color: #ffffff;
  box-shadow: 0 16rpx 38rpx rgba(23, 25, 28, 0.18);
}

.collector-identity,
.collector-money-row,
.action-row,
.action-money-wrap {
  display: flex;
  align-items: center;
}

.collector-avatar,
.action-avatar,
.chip-avatar {
  display: flex;
  align-items: center;
  justify-content: center;
  flex: none;
  border-radius: 50%;
  font-weight: 700;
}

.collector-avatar {
  width: 82rpx;
  height: 82rpx;
  background: #ffffff;
  color: var(--ink);
  font-size: 30rpx;
}

.collector-copy {
  display: flex;
  min-width: 0;
  flex-direction: column;
  margin-left: 22rpx;
}

.hero-caption {
  overflow: hidden;
  color: #ffffff;
  font-size: 28rpx;
  font-weight: 650;
  line-height: 1.4;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.hero-label,
.hero-summary {
  color: #aeb4bd;
  font-size: 23rpx;
  line-height: 1.45;
}

.hero-label {
  margin-top: 6rpx;
}

.collector-money-row {
  align-items: baseline;
  margin-top: 30rpx;
}

.hero-currency {
  margin-right: 12rpx;
  color: #d8dbe0;
  font-size: 38rpx;
  font-weight: 650;
}

.collector-money {
  max-width: 100%;
  overflow-wrap: anywhere;
  font-size: 72rpx;
  font-weight: 720;
  font-variant-numeric: tabular-nums;
  letter-spacing: -2rpx;
  line-height: 1.1;
}

.hero-summary {
  display: block;
  margin-top: 17rpx;
}

.collector-picker {
  margin-top: 38rpx;
}

.picker-label {
  display: block;
  padding: 0 4rpx 15rpx;
  color: var(--secondary);
  font-size: 23rpx;
  font-weight: 600;
  line-height: 1.4;
}

.collector-scroll {
  width: calc(100% + 32rpx);
  margin-right: -32rpx;
  white-space: nowrap;
}

.collector-chip-row {
  display: inline-flex;
  padding-right: 32rpx;
}

.collector-chip {
  display: inline-flex;
  align-items: center;
  box-sizing: border-box;
  min-width: 150rpx;
  min-height: 88rpx;
  margin: 0 14rpx 0 0;
  padding: 8rpx 22rpx 8rpx 10rpx;
  border: 1rpx solid var(--line);
  border-radius: 44rpx;
  background: var(--surface);
  color: var(--ink);
  font-size: 25rpx;
  line-height: 1.3;
}

.collector-chip-selected {
  border-color: var(--blue);
  color: var(--blue);
  box-shadow: 0 6rpx 18rpx rgba(20, 118, 242, 0.12);
}

.chip-avatar {
  width: 62rpx;
  height: 62rpx;
  margin-right: 13rpx;
  background: #eef0f3;
  color: var(--ink);
  font-size: 23rpx;
}

.collector-chip-selected .chip-avatar {
  background: #eaf3ff;
  color: var(--blue);
}

.chip-name {
  max-width: 210rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.section-heading {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 50rpx 4rpx 20rpx;
}

.section-title {
  font-size: 30rpx;
  font-weight: 650;
}

.section-count {
  color: var(--secondary);
  font-size: 23rpx;
}

.action-list {
  overflow: hidden;
}

.action-row {
  min-height: 138rpx;
  margin: 0 30rpx;
  border-bottom: 1rpx solid var(--line);
}

.action-row:last-child {
  border-bottom: 0;
}

.action-avatar {
  width: 66rpx;
  height: 66rpx;
  background: #eef0f3;
  color: var(--ink);
  font-size: 24rpx;
}

.action-copy {
  display: flex;
  flex: 1;
  min-width: 0;
  flex-direction: column;
  padding: 24rpx 18rpx;
}

.action-route {
  overflow-wrap: anywhere;
  font-size: 28rpx;
  font-weight: 650;
  line-height: 1.4;
}

.action-detail {
  margin-top: 7rpx;
  overflow: hidden;
  color: var(--secondary);
  font-size: 22rpx;
  line-height: 1.45;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.action-money-wrap {
  align-items: baseline;
  flex: none;
  max-width: 43%;
}

.action-currency {
  margin-right: 5rpx;
  color: var(--secondary);
  font-size: 23rpx;
}

.action-money {
  overflow-wrap: anywhere;
  text-align: right;
  font-size: 35rpx;
  font-weight: 700;
  font-variant-numeric: tabular-nums;
  line-height: 1.2;
}

.settled-card {
  display: flex;
  align-items: center;
  flex-direction: column;
  padding: 74rpx 34rpx;
  text-align: center;
}

.settled-mark {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 94rpx;
  height: 94rpx;
  border-radius: 50%;
  background: #eaf3ff;
  color: var(--blue);
  font-size: 44rpx;
  font-weight: 700;
}

.settled-title {
  margin-top: 28rpx;
  font-size: 38rpx;
  font-weight: 700;
  line-height: 1.3;
}

.settled-description {
  margin-top: 10rpx;
  color: var(--secondary);
  font-size: 25rpx;
  line-height: 1.55;
}

.page-error {
  display: block;
  margin: 24rpx 6rpx 0;
  color: var(--danger);
  font-size: 24rpx;
  line-height: 1.5;
}

.bottom-actions {
  padding-top: 40rpx;
  padding-bottom: env(safe-area-inset-bottom);
}

.copy-button,
.return-button {
  box-sizing: border-box;
  width: 100%;
  margin-left: 0;
  margin-right: 0;
  font-size: 28rpx;
  font-weight: 650;
}

.copy-button {
  min-height: 104rpx;
  border-radius: 26rpx;
  background: var(--ink);
  color: #ffffff;
  line-height: 104rpx;
}

.return-button {
  min-height: 88rpx;
  margin-top: 14rpx;
  background: transparent;
  color: var(--blue);
  line-height: 88rpx;
}

.error-state {
  display: flex;
  align-items: center;
  flex-direction: column;
  padding: 96rpx 34rpx;
  text-align: center;
}

.error-title {
  font-size: 31rpx;
  font-weight: 650;
  line-height: 1.4;
}

.error-description {
  max-width: 520rpx;
  margin-top: 14rpx;
  color: var(--secondary);
  font-size: 24rpx;
  line-height: 1.6;
}

@media (max-width: 374px) {
  .finish-button,
  .collector-chip,
  .copy-button,
  .return-button {
    min-height: 44px;
  }

  .finish-button,
  .collector-chip {
    min-width: 44px;
  }

  .finish-button,
  .copy-button,
  .return-button {
    line-height: 44px;
  }
}
