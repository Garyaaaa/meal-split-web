<view class="page-shell result-page">
  <view class="result-header">
    <text class="page-title">分账结果</text>
    <button
      wx:if="{{isReady}}"
      class="finish-button"
      bindtap="finish"
      aria-label="完成并开始一笔新账单"
    >完成</button>
  </view>

  <block wx:if="{{isReady}}">
    <view wx:if="{{isSettled}}" class="settled-card card">
      <text class="settled-mark">✓</text>
      <text class="settled-title">已经结清</text>
      <text class="settled-description">所有人都无需再转账</text>
    </view>

    <block wx:else>
      <view class="collector-hero">
        <view class="collector-identity">
          <text class="collector-avatar">{{collector.initial}}</text>
          <view class="collector-copy">
            <text class="hero-caption">由 {{collector.displayName}} 统一收款</text>
            <text class="hero-label">最终净收</text>
          </view>
        </view>
        <view class="collector-money-row">
          <text class="hero-currency">¥</text>
          <text class="collector-money">{{collector.amountText}}</text>
        </view>
        <text class="hero-summary">总消费 ¥{{totalText}} · {{participantCount}} 人</text>
      </view>

      <view wx:if="{{showCollectorPicker}}" class="collector-picker">
        <text class="picker-label">更换主收款人</text>
        <scroll-view class="collector-scroll" scroll-x="true" enhanced="true" show-scrollbar="false">
          <view class="collector-chip-row">
            <button
              wx:for="{{eligibleCollectors}}"
              wx:key="id"
              class="collector-chip {{item.isSelected ? 'collector-chip-selected' : ''}}"
              data-id="{{item.id}}"
              bindtap="changeCollector"
              aria-label="选择 {{item.displayName}} 为主收款人"
              aria-pressed="{{item.isSelected}}"
            >
              <text class="chip-avatar">{{item.initial}}</text>
              <text class="chip-name">{{item.displayName}}</text>
            </button>
          </view>
        </scroll-view>
      </view>

      <view class="section-heading">
        <text class="section-title">请按下面转账</text>
        <text class="section-count">{{actionRows.length}} 笔</text>
      </view>
      <view class="action-list card">
        <view wx:for="{{actionRows}}" wx:key="key" class="action-row">
          <text class="action-avatar">{{item.avatarInitial}}</text>
          <view class="action-copy">
            <text class="action-route">{{item.fromName}} 转给 {{item.toName}}</text>
            <text class="action-detail">{{item.detail}}</text>
          </view>
          <view class="action-money-wrap">
            <text class="action-currency">¥</text>
            <text class="action-money">{{item.amountText}}</text>
          </view>
        </view>
      </view>
    </block>

    <text wx:if="{{pageError}}" class="page-error" aria-role="alert">{{pageError}}</text>
    <view class="bottom-actions">
      <button
        class="copy-button"
        bindtap="copyResult"
        aria-label="复制群聊结算文案"
      >复制群聊结算文案</button>
      <button
        class="return-button"
        bindtap="returnToLedger"
        aria-label="返回修改账单"
      >返回修改</button>
    </view>
  </block>

  <view wx:else class="error-state">
    <text class="error-title">暂时无法显示结算结果</text>
    <text class="error-description">{{pageError || '正在返回安全页面…'}}</text>
  </view>
</view>
