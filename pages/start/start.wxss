.start-page {
  box-sizing: border-box;
  min-height: 100vh;
  overflow-x: hidden;
}

.draft-card {
  display: flex;
  align-items: center;
  margin-bottom: 56rpx;
  padding: 28rpx 20rpx 28rpx 30rpx;
}

.draft-copy {
  display: flex;
  flex: 1;
  min-width: 0;
  flex-direction: column;
}

.draft-title {
  font-size: 29rpx;
  font-weight: 600;
  line-height: 1.4;
}

.draft-description {
  margin-top: 6rpx;
  color: var(--secondary);
  font-size: 23rpx;
  line-height: 1.45;
}

.draft-link {
  flex: none;
  min-width: 152rpx;
  min-height: 80rpx;
  margin: 0 0 0 18rpx;
  padding: 0 16rpx;
  background: transparent;
  color: var(--blue);
  font-size: 26rpx;
  font-weight: 600;
  line-height: 80rpx;
}

.hero {
  display: flex;
  flex-direction: column;
  padding: 18rpx 4rpx 42rpx;
}

.eyebrow {
  color: var(--secondary);
  font-size: 24rpx;
  font-weight: 600;
  letter-spacing: 3rpx;
  line-height: 1.4;
}

.headline {
  margin-top: 18rpx;
  font-size: 58rpx;
  font-weight: 700;
  letter-spacing: -2rpx;
  line-height: 1.18;
}

.hero-description {
  margin-top: 18rpx;
  color: var(--secondary);
  font-size: 26rpx;
  line-height: 1.6;
}

.segmented {
  display: flex;
  box-sizing: border-box;
  width: 100%;
  margin-bottom: 28rpx;
  padding: 6rpx;
  border: 1rpx solid var(--line);
  border-radius: 24rpx;
  background: #eaeaed;
}

.segment {
  flex: 1;
  min-width: 0;
  min-height: 80rpx;
  margin: 0;
  padding: 0 20rpx;
  border-radius: 19rpx;
  background: transparent;
  color: var(--secondary);
  font-size: 27rpx;
  font-weight: 600;
  line-height: 80rpx;
}

.segment-active {
  background: var(--surface);
  color: var(--ink);
  box-shadow: 0 3rpx 12rpx rgba(23, 25, 28, 0.09);
}

.setup-card {
  box-sizing: border-box;
  width: 100%;
  padding: 34rpx;
}

.count-row,
.names-heading,
.name-row {
  display: flex;
  align-items: center;
}

.count-row,
.names-heading {
  justify-content: space-between;
}

.section-label {
  display: block;
  font-size: 28rpx;
  font-weight: 600;
  line-height: 1.4;
}

.count-caption {
  display: block;
  margin-top: 5rpx;
  color: var(--secondary);
  font-size: 23rpx;
  line-height: 1.4;
}

.stepper {
  display: flex;
  align-items: center;
}

.stepper-button {
  width: 80rpx;
  height: 80rpx;
  min-height: 80rpx;
  margin: 0;
  padding: 0;
  border-radius: 50%;
  background: #f1f2f4;
  color: var(--ink);
  font-size: 38rpx;
  line-height: 80rpx;
}

.stepper-button[disabled] {
  color: #b8bdc5;
  opacity: 1;
}

.count-value {
  width: 90rpx;
  text-align: center;
  font-size: 40rpx;
  font-weight: 650;
  font-variant-numeric: tabular-nums;
}

.letter-preview {
  display: flex;
  flex-wrap: wrap;
  margin: 36rpx -8rpx -16rpx;
}

.letter-chip {
  display: flex;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
  width: 76rpx;
  height: 76rpx;
  margin: 0 8rpx 16rpx;
  border: 1rpx solid var(--line);
  border-radius: 50%;
  background: #fafafa;
  font-size: 27rpx;
  font-weight: 650;
}

.names-heading {
  padding-bottom: 20rpx;
}

.names-heading .count-caption {
  margin-top: 0;
}

.name-row {
  min-height: 96rpx;
  border-top: 1rpx solid var(--line);
}

.name-index {
  flex: none;
  width: 48rpx;
  color: var(--secondary);
  font-size: 23rpx;
  font-variant-numeric: tabular-nums;
}

.name-input {
  flex: 1;
  min-width: 0;
  height: 88rpx;
  color: var(--ink);
  font-size: 29rpx;
}

.input-placeholder {
  color: #b3b7be;
}

.delete-button {
  flex: none;
  min-width: 96rpx;
  min-height: 80rpx;
  margin: 0 0 0 12rpx;
  padding: 0 12rpx;
  background: transparent;
  color: var(--secondary);
  font-size: 24rpx;
  line-height: 80rpx;
}

.delete-button[disabled] {
  color: #c5c8ce;
  opacity: 1;
}

.add-button {
  min-height: 88rpx;
  margin: 20rpx 0 0;
  border-radius: 20rpx;
  background: #f1f2f4;
  color: var(--ink);
  font-size: 26rpx;
  font-weight: 600;
  line-height: 88rpx;
}

.form-error {
  display: block;
  margin: 22rpx 6rpx 0;
  color: var(--danger);
  font-size: 25rpx;
  line-height: 1.5;
}

.submit-button {
  box-sizing: border-box;
  width: 100%;
  min-height: 104rpx;
  margin: 34rpx 0 0;
  padding: 0 28rpx;
  font-size: 29rpx;
  line-height: 104rpx;
}
