.editor-layer {
  position: fixed;
  z-index: 100;
  top: 0;
  right: 0;
  bottom: 0;
  left: 0;
}

.editor-mask {
  position: absolute;
  top: 0;
  right: 0;
  bottom: 0;
  left: 0;
  background: rgba(20, 22, 26, 0.46);
}

.editor-sheet {
  position: absolute;
  right: 0;
  bottom: 0;
  left: 0;
  box-sizing: border-box;
  max-height: 90vh;
  overflow: hidden;
  border-radius: 36rpx 36rpx 0 0;
  background: #f7f7f9;
  box-shadow: 0 -12rpx 42rpx rgba(23, 25, 28, 0.16);
}

.sheet-handle {
  width: 72rpx;
  height: 8rpx;
  margin: 16rpx auto 6rpx;
  border-radius: 8rpx;
  background: #c8ccd2;
}

.sheet-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 14rpx 32rpx 20rpx;
}

.sheet-title {
  font-size: 38rpx;
  font-weight: 700;
  letter-spacing: -1rpx;
}

.close-button {
  min-width: 100rpx;
  min-height: 76rpx;
  margin: 0 -12rpx 0 0;
  padding: 0 12rpx;
  background: transparent;
  color: #1476f2;
  font-size: 26rpx;
  font-weight: 600;
  line-height: 76rpx;
}

.editor-scroll {
  box-sizing: border-box;
  max-height: calc(90vh - 106rpx);
  padding: 0 32rpx calc(32rpx + env(safe-area-inset-bottom));
}

.field-block {
  margin-bottom: 24rpx;
  padding: 30rpx;
  border-radius: 28rpx;
  background: #ffffff;
}

.field-label {
  display: block;
  margin-bottom: 20rpx;
  color: #747b85;
  font-size: 24rpx;
  font-weight: 600;
  line-height: 1.4;
}

.amount-field {
  display: flex;
  align-items: baseline;
}

.currency-mark {
  flex: none;
  margin-right: 14rpx;
  color: #17191c;
  font-size: 42rpx;
  font-weight: 650;
}

.amount-input {
  flex: 1;
  min-width: 0;
  height: 90rpx;
  color: #17191c;
  font-size: 68rpx;
  font-weight: 700;
  font-variant-numeric: tabular-nums;
  line-height: 90rpx;
}

.editor-placeholder {
  color: #b7bbc2;
}

.chip-wrap,
.bearer-wrap {
  display: flex;
  flex-wrap: wrap;
  margin: 0 -7rpx -14rpx;
}

.choice-chip,
.bearer-chip {
  box-sizing: border-box;
  min-height: 76rpx;
  margin: 0 7rpx 14rpx;
  padding: 0 24rpx;
  border: 1rpx solid #e2e5e9;
  border-radius: 38rpx;
  background: #f3f4f6;
  color: #30343a;
  font-size: 25rpx;
  font-weight: 600;
  line-height: 74rpx;
}

.choice-chip-active {
  border-color: #1476f2;
  background: #1476f2;
  color: #ffffff;
}

.split-segments {
  display: flex;
  padding: 6rpx;
  border-radius: 22rpx;
  background: #eceef1;
}

.split-segment {
  flex: 1;
  min-height: 76rpx;
  margin: 0;
  padding: 0 14rpx;
  border-radius: 17rpx;
  background: transparent;
  color: #747b85;
  font-size: 25rpx;
  font-weight: 600;
  line-height: 76rpx;
}

.split-segment-active {
  background: #ffffff;
  color: #17191c;
  box-shadow: 0 3rpx 12rpx rgba(23, 25, 28, 0.08);
}

.bearer-wrap {
  margin-top: 22rpx;
}

.bearer-chip {
  display: flex;
  align-items: center;
  padding: 0 22rpx;
  line-height: 1;
}

.bearer-chip-active {
  border-color: #90bdf7;
  background: #eaf3ff;
  color: #0c64d6;
}

.check-mark {
  display: inline-block;
  width: 28rpx;
  margin-right: 4rpx;
  color: #1476f2;
  font-size: 25rpx;
}

.note-block {
  position: relative;
}

.note-input {
  box-sizing: border-box;
  width: 100%;
  min-height: 78rpx;
  padding: 0 0 34rpx;
  color: #17191c;
  font-size: 28rpx;
  line-height: 1.55;
}

.note-limit {
  position: absolute;
  right: 30rpx;
  bottom: 24rpx;
  color: #9a9fa8;
  font-size: 21rpx;
}

.editor-error {
  display: block;
  margin: 4rpx 6rpx 22rpx;
  color: #d94a4a;
  font-size: 25rpx;
  line-height: 1.5;
}

.save-button {
  box-sizing: border-box;
  width: 100%;
  min-height: 100rpx;
  margin: 0 0 12rpx;
  padding: 0 28rpx;
  border-radius: 25rpx;
  background: #17191c;
  color: #ffffff;
  font-size: 29rpx;
  font-weight: 650;
  line-height: 100rpx;
}
